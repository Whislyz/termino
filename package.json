{
  "name": "@whislyz/termino",
  "version": "0.3.0",
  "description": "Type `termino` and it splits your terminal to play an endless runner beside your work. Half-block pixel art, zero dependencies.",
  "bin": {
    "termino": "bin/termino.js"
  },
  "main": "bin/termino.js",
  "type": "commonjs",
  "files": [
    "bin/",
    "test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/termino.js",
    "test": "node test/clearance.js && node test/autoplay.js 30",
    "test:clearance": "node test/clearance.js",
    "test:autoplay": "node test/autoplay.js 120",
    "preflight": "node scripts/preflight.js",
    "prepublishOnly": "node scripts/preflight.js && npm test",
    "postpublish": "git push --follow-tags origin main",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "game",
    "terminal",
    "cli",
    "tui",
    "ascii",
    "dinosaur",
    "endless-runner",
    "split-pane",
    "tmux",
    "iterm2",
    "no-dependencies"
  ],
  "author": "Toan Tran (https://github.com/Whislyz)",
  "license": "MIT",
  "homepage": "https://github.com/Whislyz/termino#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whislyz/termino.git"
  },
  "bugs": {
    "url": "https://github.com/Whislyz/termino/issues"
  },
  "engines": {
    "node": ">=14"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  }
}
